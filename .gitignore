# Bytecode de Python
__pycache__/
*.pyc

# Entornos virtuales (los crea scripts/setup.sh)
venv/
.venv/

# Salidas que genera el programa al ejecutarse. Los nombres concretos se
# configuran con LOG_FILE y SNAPSHOT_FILE en los BM*.yaml; los patrones cubren
# los valores por defecto.
*.log
*.csv
bitaxepid_snapshot*.json
*.json.tmp

# Directorio de datos del perfil seguro y del contenedor (LOG_FILE y
# SNAPSHOT_FILE apuntan ahi; docker-compose.yml lo monta como volumen).
data/

# Variables locales de docker compose: llevan la IP del miner, que es de cada
# uno. La plantilla versionada es .env.example.
.env
